# Single entry point for the extracted services (auth, dispatch). The gateway
# fronts them over gRPC; the driver app only talks HTTP/JSON to one host.
# Android emulator uses 10.0.2.2; use localhost for the iOS Simulator or a LAN
# IP for a device.
EXPO_PUBLIC_GATEWAY_URL=http://10.0.2.2:9010/api/v1/gateway

# OpenStreetMap raster tiles for the active-task route map. The public endpoint
# is rate-limited and for development only; use a production tile provider or a
# self-hosted server for real traffic.
EXPO_PUBLIC_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Firebase web app config used for driver email/password sign-in.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
